# Copy to .env. Never commit real credentials.
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://profit:profit@localhost:5432/profit_dashboard

# From the Partner Dashboard / `shopify app dev` (placeholders only).
SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SCOPES=read_orders,read_products,read_inventory
SHOPIFY_APP_URL=https://localhost

# Billing switch:
#   shopify_app_pricing (default) — Shopify-hosted plan page. Preferred for new public apps.
#   package                     — @shopify/shopify-app-react-router billing.request (Manual Pricing).
#   manual_raw                  — appSubscriptionCreate GraphQL mutation (legacy Billing API).
BILLING_MODE=shopify_app_pricing

# App handle used to build the Shopify App Pricing URL:
# https://admin.shopify.com/store/{store}/charges/{SHOPIFY_APP_HANDLE}/pricing_plans
SHOPIFY_APP_HANDLE=profit-dashboard

NODE_ENV=development
