# Copy to .env for values this app owns. Do not commit .env.
#
# Do NOT set SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL, or SCOPES here.
# `shopify app dev` injects those. A copy of placeholder values in .env overrides
# the CLI and the embedded app falls through to the public login page.

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://profit:profit@localhost:5432/profit_dashboard

# Billing switch:
#   shopify_app_pricing (default) — Shopify-hosted plan page. Preferred for new public apps.
#   package                     — @shopify/shopify-app-react-router billing.request.
#   manual_raw                  — appSubscriptionCreate GraphQL mutation.
BILLING_MODE=shopify_app_pricing

# App handle for the hosted pricing URL:
# https://admin.shopify.com/store/{store}/charges/{SHOPIFY_APP_HANDLE}/pricing_plans
SHOPIFY_APP_HANDLE=profit-dashboard-214
